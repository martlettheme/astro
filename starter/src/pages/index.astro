---
import { Layout, Container, SectionHeading, Card, Button } from '@martlet/astro';
---
<Layout title="Your Martlet website" description="A starting point for your own content.">
  <Container>
    <h1>Your website starts here.</h1>
    <p>Replace this example with your own words and identity.</p>
    <SectionHeading title="Built on shared foundations" eyebrow="Martlet" />
    <Card>
      <h3>Make it yours</h3>
      <p>Serif prose, sans serif controls, and monospace code each have their own role.</p>
      <pre><code>npm run dev</code></pre>
      <Button href="#example">Explore the example</Button>
    </Card>
    <section id="example" class="martlet-section">
      <h2>Forms and tables</h2>
      <label for="name">Name</label><input id="name" name="name" autocomplete="name" />
      <Button disabled>Disabled example</Button>
      <div data-martlet="dark" class="martlet martlet-card"><h3>Dark appearance</h3><p>Both modes can coexist.</p><Button href="#">A dark-mode link</Button></div>
    </section>
  </Container>
</Layout>
