---
import type { HTMLAttributes } from 'astro/types';
import { choice, type Space, type Tag } from '../options';
interface Props extends HTMLAttributes<'div'> { as?: Tag; space?: Space; justify?: 'start' | 'end' | 'between'; }
const { as: Tag = 'div', space = 'regular', justify = 'start', class: className, ...attributes } = Astro.props;
choice(space,['small','regular','large'],'space');choice(justify,['start','end','between'],'justify');
choice(Tag,['div','section','article','nav','ul','ol'],'as');
---
<Tag class:list={['martlet-cluster',`martlet-space-${space}`,`martlet-cluster--${justify}`,className]} {...attributes}><slot /></Tag>
