---
import '../styles.css';
interface Props {
  title: string;
  description?: string;
  lang?: string;
  mode?: 'light' | 'dark';
  mainId?: string;
  mainTabindex?: number;
  class?: string;
  bodyClass?: string;
  skipLabel?: string;
}
const { title, description, lang = 'en', mode = 'light', mainId = 'main-content', mainTabindex, class: htmlClass, bodyClass, skipLabel = 'Skip to content' } = Astro.props;
---
<!doctype html>
<html lang={lang} class={htmlClass} data-martlet={mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <slot name="head" />
  </head>
  <body class:list={['martlet', bodyClass]}>
    <a class="martlet-skip-link" href={`#${mainId}`}>{skipLabel}</a>
    <slot name="header" />
    <main id={mainId} tabindex={mainTabindex}><slot /></main>
    <slot name="footer" />
    <slot name="body-end" />
  </body>
</html>
