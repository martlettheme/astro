---
import type { HTMLAttributes } from 'astro/types';
import { choice, type Space, type Tag } from '../options';
interface Props extends HTMLAttributes<'div'> { as?: Tag; space?: Space; columns?: 1 | 2 | 3 | 4; }
const { as: Tag = 'div', space = 'regular', columns = 3, class: className, ...attributes } = Astro.props;
choice(space,['small','regular','large'],'space');choice(columns,[1,2,3,4],'columns');
choice(Tag,['div','section','article','nav','ul','ol'],'as');
---
<Tag class:list={['martlet-grid',`martlet-space-${space}`,`martlet-grid--${columns}`,className]} {...attributes}><slot /></Tag>
