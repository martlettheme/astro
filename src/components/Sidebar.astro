---
import type { HTMLAttributes } from 'astro/types';
import { choice, type Space } from '../options';
interface Props extends HTMLAttributes<'div'> { space?: Space; side?: 'start' | 'end'; sidebarLabel?: string; }
const { space = 'regular', side = 'end', sidebarLabel = 'Supporting information', class: className, ...attributes } = Astro.props;
choice(space,['small','regular','large'],'space');choice(side,['start','end'],'side');
---
<div class:list={['martlet-sidebar',`martlet-space-${space}`,className]} {...attributes}>
  {side === 'start' && <aside class="martlet-sidebar__aside" aria-label={sidebarLabel}><slot name="sidebar" /></aside>}
  <div class="martlet-sidebar__main"><slot /></div>
  {side === 'end' && <aside class="martlet-sidebar__aside" aria-label={sidebarLabel}><slot name="sidebar" /></aside>}
</div>
