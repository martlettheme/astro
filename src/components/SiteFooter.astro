---
import Container from './Container.astro';
import Stack from './Stack.astro';
import Cluster from './Cluster.astro';
interface FooterLink { href: string; label: string; }
interface Props { links?: FooterLink[]; groups?: {label: string; links: FooterLink[]}[]; variant?: 'plain' | 'grouped'; navigationLabel?: string; class?: string; }
const { links = [], groups = [], variant = 'plain', navigationLabel = 'Footer navigation', class: className } = Astro.props;
---
<footer class:list={['martlet-site-footer',variant === 'grouped' && 'martlet-site-footer--grouped',className]}><Container>
  {variant === 'plain' ? <Stack><slot />{links.length > 0 && <nav aria-label={navigationLabel}><Cluster as="ul" space="small">{links.map(link=><li><a href={link.href}>{link.label}</a></li>)}</Cluster></nav>}<slot name="identity" /><slot name="base" /></Stack> : <Fragment><slot /><div class="martlet-site-footer__groups">{groups.map(group=><nav class="martlet-site-footer__group" aria-label={group.label}><h2>{group.label}</h2><ul>{group.links.map(link=><li><a href={link.href}>{link.label}</a></li>)}</ul></nav>)}</div>{(Astro.slots.has('identity') || Astro.slots.has('base')) && <div class="martlet-site-footer__base">{Astro.slots.has('identity') && <div class="martlet-site-footer__identity"><slot name="identity" /></div>}<slot name="base" /></div>}{links.length > 0 && <nav aria-label={navigationLabel}><Cluster as="ul" space="small">{links.map(link=><li><a href={link.href}>{link.label}</a></li>)}</Cluster></nav>}</Fragment>}
</Container></footer>
